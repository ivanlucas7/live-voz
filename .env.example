# Obrigatória: chave do Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Opcional: senha para usar o app. Vazia = qualquer pessoa com o link pode usar (e gastar sua cota).
APP_PASSWORD=

# Opcional: troca a Busca Google embutida no Gemini pela busca do OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.6-luna

# Opcional: modelo do Gemini Live
# GEMINI_MODEL=gemini-3.1-flash-live-preview
